{
  "name": "forma-strength",
  "version": "1.0.0",
  "private": true,
  "description": "Forma - local-first strength, nutrition and physique tracker (Android via Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test:e2e": "vite build && node tests/e2e.mjs",
